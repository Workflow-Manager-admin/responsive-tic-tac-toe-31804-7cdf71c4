{"openapi":"3.1.0","info":{"title":"Tic Tac Toe Backend API","description":"API for in-memory Tic Tac Toe game. Allows creation/reset, making moves, and retrieving game state.","version":"1.0.0"},"paths":{"/":{"get":{"tags":["game"],"summary":"Health check","description":"Simple health/status check for backend.","operationId":"health_check__get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MessageResponse"}}}}}}},"/game/new":{"post":{"tags":["game"],"summary":"Start or reset game","description":"Starts a new game or resets state.","operationId":"new_game_game_new_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GameStateResponse"}}}}}}},"/game/move":{"post":{"tags":["game"],"summary":"Make a move","description":"Make a move at specified row/column for the current player. Returns updated game state.","operationId":"make_move_game_move_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/MoveRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GameStateResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/game/state":{"get":{"tags":["game"],"summary":"Get current game state","description":"Retrieves current board, player, winner, and draw status.","operationId":"get_game_state_game_state_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GameStateResponse"}}}}}}}},"components":{"schemas":{"GameStateResponse":{"properties":{"board":{"items":{"items":{"anyOf":[{"type":"string"},{"type":"null"}]},"type":"array"},"type":"array","title":"Board","description":"3x3 board, each cell is '', 'X', or 'O'"},"current_player":{"type":"string","enum":["X","O"],"title":"Current Player"},"winner":{"anyOf":[{"type":"string","enum":["X","O"]},{"type":"null"}],"title":"Winner","description":"Winner if any"},"is_draw":{"type":"boolean","title":"Is Draw"}},"type":"object","required":["board","current_player","is_draw"],"title":"GameStateResponse"},"HTTPValidationError":{"properties":{"detail":{"items":{"$ref":"#/components/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"MessageResponse":{"properties":{"message":{"type":"string","title":"Message"}},"type":"object","required":["message"],"title":"MessageResponse"},"MoveRequest":{"properties":{"row":{"type":"integer","maximum":2.0,"minimum":0.0,"title":"Row","description":"Row index: 0-2"},"col":{"type":"integer","maximum":2.0,"minimum":0.0,"title":"Col","description":"Column index: 0-2"},"player":{"type":"string","enum":["X","O"],"title":"Player","description":"Player making the move ('X' or 'O')"}},"type":"object","required":["row","col","player"],"title":"MoveRequest"},"ValidationError":{"properties":{"loc":{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array","title":"Location"},"msg":{"type":"string","title":"Message"},"type":{"type":"string","title":"Error Type"}},"type":"object","required":["loc","msg","type"],"title":"ValidationError"}}},"tags":[{"name":"game","description":"Core gameplay and game state endpoints"}]}